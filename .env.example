# Server-only settings. Copy to .env.local for local development.
POSTGRES_DB=wrenchbid
POSTGRES_USER=wrenchbid
POSTGRES_PASSWORD=wrenchbid_local_only
# Loopback-only by default. See docs/OPERATIONS.md before exposing this port.
APP_HOST=127.0.0.1
APP_PORT=3000
DATABASE_URL=postgresql://wrenchbid:wrenchbid_local_only@localhost:5432/wrenchbid
UPLOAD_DIR=./data/uploads
PUBLIC_APP_URL=http://localhost:3000
ALLOW_ANONYMOUS_PROJECTS=true
OUTBOUND_CALLS_ENABLED=false
MAX_CAMPAIGNS_PER_PROJECT_PER_DAY=3
SUPPRESSED_PHONE_NUMBERS=
RETENTION_DAYS=30

# Provider credentials must never use the VITE_ prefix.
ELEVENLABS_API_KEY=
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_CALLER_AGENT_ID=
ELEVENLABS_NEGOTIATOR_AGENT_ID=
# Telephony is intentionally isolated: this environment has no Twilio/SIP/PSTN
# access, OUTBOUND_CALLS_ENABLED stays false, and every demo/product flow is
# web-based. Leave the two values below empty unless a real operator-owned
# telephony integration is configured and legally reviewed.
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TELEPHONY_PROVIDER=twilio
ELEVENLABS_ENVIRONMENT=production
# Task-routed model selection (defaults shown; see docs/model-selection.md).
# ELEVENLABS_TTS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_DIALOGUE_MODEL_ID=eleven_v3
# ELEVENLABS_SIMULATION_LLM=gemini-3.5-flash
TAVILY_API_KEY=

